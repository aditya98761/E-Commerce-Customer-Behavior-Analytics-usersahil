# Copy to backend/.env and edit. Never commit the real .env.
DATABASE_URL=postgresql+psycopg2://bda_user:change_me@localhost:5432/ecommerce_bda
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

# Olist RFM uses Spark by default; other analytics keep their existing engines.
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=4
SPARK_JDBC_PACKAGE=org.postgresql:postgresql:42.7.14
# Optional absolute PostgreSQL JDBC JAR path (avoids the Maven download).
SPARK_JDBC_JAR=
SPARK_JOB_TIMEOUT_SECONDS=1800
